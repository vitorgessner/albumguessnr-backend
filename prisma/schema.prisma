// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                              String                           @id @default(uuid())
  email                           String?                          @unique
  emailVerified                   Boolean                          @default(false)
  password                        String?
  createdAt                       DateTime                         @default(now())
  isGuest                         Boolean                          @default(false)
  userStats                       UserStats?
  profile                         Profile?
  accounts                        Account[]
  mainAccountId                   String?                          @unique
  mainAccount                     Account?                         @relation("mainAccount", fields: [mainAccountId], references: [id], onDelete: SetNull)
  userAlbumFamiliarity            UserAlbumFamiliarity[]
  verificationToken               VerificationToken[]
  refreshToken                    RefreshToken[]
  userAlbumScores                 UserAlbumScores[]
  userGuessAttempts               GuessAttempt[]
  userAlbumStats                  UserAlbumStats[]
  sentRequests                    UserFriends[]                    @relation("sentRequests")
  receivedRequests                UserFriends[]                    @relation("receivedRequests")
  failedAlbumsSync                FailedAlbumsSync[]
  albumDataErrorLog               UserAlbumDataErrorsLogs[]
  dailyAlbumGuesses               UserDailyAlbum[]
  userDailyAlbumOverallStatistics UserDailyAlbumOverallStatistics?
}

model UserStats {
  id                    String @id @default(uuid())
  userId                String @unique
  user                  User   @relation(fields: [userId], references: [id])
  totalScore            Int    @default(0)
  guessedDistinctAlbums Int    @default(0)
  guessedAlbums         Int    @default(0)
  rightGuessedAlbums    Int    @default(0)
  guessedArtists        Int    @default(0)
  rightGuessedArtist    Int    @default(0)
  guessedGenres         Int    @default(0)
  rightGuessedGenres    Int    @default(0)
  guessedYears          Int    @default(0)
  rightGuessedYears     Int    @default(0)
  guessedTracks         Int    @default(0)
  rightGuessedTracks    Int    @default(0)
}

model Profile {
  id              String   @id @default(uuid())
  username        String   @unique
  displayUsername String   @default("")
  bio             String   @default("")
  avatar_url      String
  updatedAt       DateTime @updatedAt
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
}

model Account {
  id                 String     @id @default(uuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMainAccount    User?      @relation("mainAccount")
  provider           String
  providerAccountId  String
  accessToken        String?    @db.Text
  refreshToken       String?    @db.Text
  expiresAt          DateTime?
  username           String
  displayUsername    String     @default("")
  lastSyncedAt       DateTime?
  syncCursor         Int        @default(1)
  syncStatus         SyncStatus @default(IDLE)
  syncingTimestamp   DateTime?
  hadFailuresInChain Boolean    @default(false)

  @@unique([provider, providerAccountId])
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  SUCCEEDWITHFAILURE
  FAILED
}

model VerificationToken {
  token          String   @id
  expirationTime DateTime
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  token          String   @id
  expirationTime DateTime
  userId         String
  user           User     @relation(fields: [userId], references: [id])
}

model GuessAttempt {
  id            String                 @id @default(uuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id])
  albumId       String
  album         Album                  @relation(fields: [albumId], references: [id])
  date          DateTime               @default(now())
  totalScore    Int                    @default(0)
  tracksHit     Int                    @default(0)
  timeSpent     Int
  categories    GuessAttemptCategory[]
  guessedTracks GuessedTrack[]

  @@index([userId, albumId, date])
  @@index([albumId])
}

model GuessedTrack {
  trackId        String
  track          Track        @relation(fields: [trackId], references: [id])
  guessAttemptId String
  guessAttempt   GuessAttempt @relation(fields: [guessAttemptId], references: [id])
  isCorrect      Boolean

  @@id([trackId, guessAttemptId])
}

model GuessAttemptCategory {
  id             String       @id @default(uuid())
  guessAttemptId String
  guessAttempt   GuessAttempt @relation(fields: [guessAttemptId], references: [id])
  category       GameCategory
  score          Int          @default(0)
}

model UserAlbumScores {
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  albumId   String
  album     Album        @relation(fields: [albumId], references: [id])
  gameMode  GameCategory
  date      DateTime     @db.Date
  bestScore Int          @default(0)

  @@id([userId, albumId, gameMode, date])
}

enum GameCategory {
  ALBUM
  ARTIST
  GENRE
  YEAR
  TRACKLIST
}

model UserAlbumStats {
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  albumId         String
  album           Album    @relation(fields: [albumId], references: [id])
  lastTimeGuessed DateTime
  timesGuessed    Int

  @@id([userId, albumId])
}

model UserAlbumFamiliarity {
  timesListened    Int?
  tracksListened   Int?
  familiarityScore Float
  lastTimeListened DateTime
  albumId          String
  album            Album    @relation(fields: [albumId], references: [id])
  userId           String
  user             User?    @relation(fields: [userId], references: [id])

  @@id([userId, albumId])
  @@index([userId])
}

model UserFriends {
  sentRequestsId     String
  sentRequests       User         @relation("sentRequests", fields: [sentRequestsId], references: [id])
  receivedRequestsId String
  receivedRequests   User         @relation("receivedRequests", fields: [receivedRequestsId], references: [id])
  stat               FriendsStats
  timesRequested     Int          @default(0)
  timesRejected      Int          @default(0)
  lastRequestedAt    DateTime     @default(now())

  @@id([sentRequestsId, receivedRequestsId])
}

enum FriendsStats {
  PENDING
  FRIEND
  DENIED
  CANCELLED_REQUEST
}

model Album {
  id                     String                 @id @default(uuid())
  mbid                   String?
  name                   String
  normalizedName         String
  normalizedArtist       String
  year                   String?
  cover_url              String
  genres                 AlbumsGenre[]
  artists                AlbumsArtist[]
  userAlbumFamiliarities UserAlbumFamiliarity[]
  userAlbumScores        UserAlbumScores[]
  guessAttempts          GuessAttempt[]
  userAlbumStats         UserAlbumStats[]
  tracks                 Track[]
  rymRating              Decimal?
  rymRanking             Decimal?
  descriptors            String[]
  dailyAlbum             DailyAlbum?
  albumPools             AlbumPools[]
  dailyAlbumTries        DailyAlbumTry[]

  @@unique([normalizedName, normalizedArtist])
}

model DailyAlbum {
  albumId         String           @id @unique
  album           Album            @relation(fields: [albumId], references: [id])
  lastfmListeners String?
  lastfmPlaycount String?
  date            DateTime         @unique
  userGuesses     UserDailyAlbum[]
}

model AlbumPools {
  albumId        String    @id @unique
  album          Album     @relation(fields: [albumId], references: [id])
  electable      Boolean   @default(true)
}

model UserDailyAlbum {
  id               String               @id @default(uuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id])
  dailyAlbumId     String
  dailyAlbum       DailyAlbum           @relation(fields: [dailyAlbumId], references: [albumId])
  nthPlayerToGuess Int?
  status           UserDailyAlbumStatus
  userTries        DailyAlbumTry[]

  @@unique([userId, dailyAlbumId])
}

enum UserDailyAlbumStatus {
  UNFINISHED
  FINISHED
}

model DailyAlbumTry {
  id               String         @id @default(uuid())
  userDailyAlbumId String
  userDailyAlbum   UserDailyAlbum @relation(fields: [userDailyAlbumId], references: [id])
  nthTry           Int
  albumGuessId     String
  albumGuess       Album          @relation(fields: [albumGuessId], references: [id])
  timestamp        DateTime

  @@unique([userDailyAlbumId, albumGuessId])
}

model UserDailyAlbumOverallStatistics {
  userId               String @id
  user                 User   @relation(fields: [userId], references: [id])
  totalGuessed         Int    @default(0)
  correctlyGuessed     Int    @default(0)
  meanToGuess          Float    @default(0)
  numberOfFirstGuesses Int    @default(0)
  currentStreak        Int    @default(0)
  maxStreak            Int    @default(0)
}

model Genre {
  id     String        @id @default(uuid())
  name   String        @unique
  albums AlbumsGenre[]
}

model AlbumsGenre {
  albumId String
  genreId String
  album   Album  @relation(fields: [albumId], references: [id])
  genre   Genre  @relation(fields: [genreId], references: [id])

  @@id([albumId, genreId])
}

model Artist {
  id             String         @id @default(uuid())
  mbid           String?
  name           String
  normalizedName String         @unique
  albums         AlbumsArtist[]
}

model AlbumsArtist {
  albumId  String
  artistId String
  album    Album  @relation(fields: [albumId], references: [id])
  artist   Artist @relation(fields: [artistId], references: [id])

  @@id([albumId, artistId])
}

model Track {
  id             String         @id @default(uuid())
  name           String
  normalizedName String
  albumId        String
  album          Album          @relation(fields: [albumId], references: [id])
  guessedTracks  GuessedTrack[]

  @@unique([normalizedName, albumId])
}

model FailedAlbumsSync {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  albumName       String
  albumId         String       @default("")
  mbid            String?
  artist          String
  normalizedAlbum String
  cause           Json
  status          ErrorStatus  @default(PENDING)
  apiError        PossibleApis
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([albumName, artist, apiError])
}

model UserAlbumDataErrorsLogs {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  albumName        String
  albumId          String
  mbid             String?
  artist           String
  normalizedAlbum  String
  fieldsWithErrors String
  description      String
  status           ErrorStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

enum ErrorStatus {
  PENDING
  RESOLVED
}

enum PossibleApis {
  LASTFM
  SPOTIFY
  MUSICBRAINZ
  SERVER
}
